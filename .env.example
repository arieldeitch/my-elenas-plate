# Supabase — copy to `.env` and fill in from your Supabase project
# (Project Settings → API). Only the anon (public) key belongs in the client.
# NEVER put the service_role key here or anywhere in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When both are empty/unset the app runs in local demo mode (localStorage only).

# What this build is MEANT to be (docs/RUNTIME_CONFIG.md §1a):
#   shared → the couple app; Supabase config is REQUIRED, otherwise the app is blocked.
#            This is the default for every production build — leave unset in Lovable.
#   demo   → a deliberate local/demo build (default for `vite dev`).
# VITE_RUNTIME_TARGET=
