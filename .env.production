# Production runtime configuration for the SHARED couple app — committed on purpose.
# Loaded by every `vite build` (Vite mode "production"), including Lovable's publish.
# See docs/RUNTIME_CONFIG.md §3 and DEC-025. Only PUBLIC values belong here:
#   - the project URL (already visible in every served bundle);
#   - the anon / publishable key (designed to ship in browsers; RLS protects the data).
# NEVER the service_role key, NEVER a database password.
# `npm run preflight -- --env` checks this file before a build.

VITE_SUPABASE_URL=https://rqgoiuztphkcvbwtbxbj.supabase.co
VITE_RUNTIME_TARGET=shared

# Owner action (M1 release): paste the anon/publishable key from
# Supabase → Project Settings → API Keys, then commit. Until this line exists the
# published build is BLOCKED by RuntimeGate (not silently demo).
# VITE_SUPABASE_ANON_KEY=
